# Copy this to .env (or export these manually) before running the dashboard.
# Never commit a real .env file -- .gitignore already excludes it.

# A long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=replace-this-with-a-random-64-char-hex-string

# Set to "true" only once the dashboard is served over HTTPS (see README's
# "Hardening for production" section). Leave "false" for local development
# over plain http://127.0.0.1, or the login cookie won't be sent.
DASHBOARD_SECURE_COOKIES=false
